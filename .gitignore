# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environment
.venv/
venv/

# Project-local uv cache (overridable with UV_CACHE_DIR)
.cache/uv/
!.cache/uv/.gitkeep

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Draw Things CLI binary (large build artifact)
./contrib/backends/draw-things/draw-things-cli
./contrib/backends/draw-things/draw-things-cli.exe

# Runtime / output artifacts
*.log
*.tmp
*.pid
*.bak

# OS
Thumbs.db

# Machine-specific global configuration (copy from config/global-config.example.yaml)
config/global-config.yaml

# The API server's bearer token (generated on first `fc serve`)
config/server-token
# The independent guest MCP credential (generated on first HTTP `fc mcp`)
config/mcp-token

# The terminal UI's own preferences (its verbose level), written by `/verbose`
config/tui-preferences.yaml
config/tui-command-history.txt

# gRPC stubs generated from server/proto/monitor.proto by `make proto` (a make check dependency); the .proto file
# stays the single source of truth, with no generated code to drift from it. One copy per front end with a gRPC
# client (server/, cli/, tui/; mcp_server/ has none, watching over SSE), since front ends never import each other.
src/framecontrol/server/generated/
src/framecontrol/cli/generated/
src/framecontrol/tui/generated/

# Personal data: everything under data/ except the example files
data/**
!data/**/
!data/**/*example*
data/jobs/.trash/
data/jobs/.backups/

# Execution history database and run lock (created at run time)
/state/

# Contribution
/contrib
