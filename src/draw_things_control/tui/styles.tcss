#main {
    height: 1fr;
}

#left {
    width: 2fr;
}

/* Owner decision: every widget but the command line and the history is on black. */
#cli, #run-line, #cli-output, #messages, #status-line {
    background: black;
}

#cli {
    height: 15;
    border: round $panel;
    border-title-color: $accent;
}

#run-line {
    height: 1;
    padding: 0 1;
}

#cli-output {
    height: 1fr;
    padding: 0 1;
}

#messages {
    height: 1fr;
    padding: 0 1;
    border: round $panel;
    border-title-color: $accent;
}

#history {
    width: 1fr;
    min-width: 36;
    height: 1fr;
    border: round $panel;
    border-title-color: $accent;
    border-subtitle-color: $warning;
}

#history:focus {
    border: round $accent;
}

Rule.command-rule {
    margin: 0;
    color: $foreground;
}

#command-line {
    height: 1;
}

#prompt {
    width: 2;
    color: $accent;
    text-style: bold;
}

#command {
    width: 1fr;
}

#command > .input--cursor {
    background: white;
    color: black;
    text-style: none;
}

#status-line {
    height: 1;
}

ConfirmScreen {
    align: center middle;
}

#confirm {
    width: auto;
    max-width: 90%;
    height: auto;
    padding: 1 3;
    border: round $warning;
    background: $surface;
}
