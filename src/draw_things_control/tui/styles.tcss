#main {
    height: 1fr;
}

#left {
    width: 2fr;
}

/* Owner decision: every widget but the command line, the history, and the execution detail is on black. */
#status, #cli, #run-line, #cli-output, #messages, #status-line {
    background: black;
}

/* 7 lines with its border: the phase, two bars, the details, and the last run (screens.STATUS_LINES). A line too long
   for the width ends in an ellipsis, never wraps into the next: Textual drops a Rich Text's own no_wrap and overflow. */
#status {
    height: 7;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: round $panel;
    border-title-color: $accent;
}

#cli {
    height: 15;
    border: round $panel;
    border-title-color: $accent;
}

#run-line {
    height: 1;
    padding: 0 1;
}

#cli-output {
    height: 1fr;
    padding: 0 1;
}

#messages {
    height: 1fr;
    padding: 0 1;
    border: round $panel;
    border-title-color: $accent;
}

#right {
    width: 1fr;
    min-width: 36;
}

/* Owner decision: 8 job rows show, so 11 lines with the border and the header (panes.JOB_DEFINITION_LINES). */
#jobs {
    height: 11;
    border: round $panel;
    border-title-color: $accent;
    border-subtitle-color: $text-muted;
}

/* Owner decision: 5 rows show, so 8 lines with the border and the header (panes.queue.QUEUE_LINES). */
#queue {
    height: 8;
    border: round $panel;
    border-title-color: $accent;
}

/* Owner decision: 5 rows show, so 8 lines with the border and the header. */
#history {
    height: 8;
    border: round $panel;
    border-title-color: $accent;
    border-subtitle-color: $warning;
}

#jobs:focus, #queue:focus, #history:focus, #execution:focus {
    border: round $accent;
}

#execution {
    height: 1fr;
    padding: 0 1;
    border: round $panel;
    border-title-color: $accent;
    scrollbar-size-vertical: 1;
    /* The file names underline themselves; a link's own style would recolor them. */
    link-style: none;
    link-color: $foreground;
    link-background: transparent;
    link-style-hover: bold underline;
    link-color-hover: $accent;
    link-background-hover: transparent;
}

#execution-body {
    width: 100%;
}

Rule.command-rule {
    margin: 0;
    color: $foreground;
}

#command-line {
    height: 1;
}

#prompt {
    width: 2;
    color: $accent;
    text-style: bold;
}

#command {
    width: 1fr;
}

#command > .input--cursor {
    background: white;
    color: black;
    text-style: none;
}

#status-line {
    height: 1;
}

/* The delete dialog (Milestone 06): a bordered box in the middle of the dimmed screen. */
DeleteDialog {
    align: center middle;
}

#delete-dialog {
    width: 90;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: round $error;
    background: $surface;
}

#delete-buttons {
    height: auto;
    margin-top: 1;
}

#delete-buttons Button {
    margin-right: 2;
}
