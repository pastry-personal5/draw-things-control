#main {
    height: 1fr;
}

#left {
    width: 2fr;
}

/* The passive work displays use the theme's background; the selectable lists and execution detail sit on its surface. */
#work-status, #generation-output, #run-summary, #output-log, #activity-log, #status-line {
    background: $background;
}

/* 7 lines with its border: the phase, two bars, the details, and the last run (screens.STATUS_LINES). A line too long
   for the width ends in an ellipsis, never wraps into the next: Textual drops a Rich Text's own no_wrap and overflow. */
#work-status {
    height: 7;
    padding: 0 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    border: round $panel;
    border-title-color: $accent;
}

#generation-output {
    height: 15;
    border: round $panel;
    border-title-color: $accent;
}

#run-summary {
    height: 1;
    padding: 0 1;
}

#output-log {
    height: 1fr;
    padding: 0 1;
}

#activity-log {
    height: 1fr;
    padding: 0 1;
    border: round $panel;
    border-title-color: $accent;
}

#right {
    width: 1fr;
    min-width: 36;
}

/* Owner decision: 8 job rows show, so 11 lines with the border and the header (panes.JOB_DEFINITION_LINES). */
#jobs-list {
    height: 11;
    border: round $panel;
    border-title-color: $accent;
    border-subtitle-color: $text-muted;
}

/* Owner decision: 5 rows show, so 8 lines with the border and the header (panes.queue.QUEUE_LINES). */
#queue-list {
    height: 8;
    border: round $panel;
    border-title-color: $accent;
}

/* Five rows show, so eight lines with the border and the header. */
#execution-history-list {
    height: 8;
    border: round $panel;
    border-title-color: $accent;
    border-subtitle-color: $warning;
}

#jobs-list:focus, #queue-list:focus, #execution-history-list:focus, #execution-detail:focus {
    border: round $accent;
}

#execution-detail {
    height: 1fr;
    padding: 0 1;
    border: round $panel;
    border-title-color: $accent;
    scrollbar-size-vertical: 1;
    /* The file names underline themselves; a link's own style would recolor them. */
    link-style: none;
    link-color: $foreground;
    link-background: transparent;
    link-style-hover: bold underline;
    link-color-hover: $accent;
    link-background-hover: transparent;
}

#execution-body {
    width: 100%;
}

Rule.command-rule {
    margin: 0;
    color: $foreground;
}

#command-line {
    height: 1;
}

#command-prompt {
    width: 2;
    color: $accent;
    text-style: bold;
}

#command-field {
    width: 1fr;
}

#command-field > .input--cursor {
    background: $foreground;
    color: $background;
    text-style: none;
}

#status-line {
    height: 1;
}

/* Shortcut help is a centered reference overlay: it offers no action of its own. */
ShortcutHelpOverlay {
    align: center middle;
}

#shortcut-help {
    width: 90%;
    max-width: 110;
    height: 90%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#shortcut-help-title {
    margin-bottom: 1;
    text-style: bold;
    color: $accent;
}

#shortcut-help-scroll {
    height: 1fr;
}

#shortcut-help-dismiss {
    margin-top: 1;
    color: $text-muted;
}

/* The text viewer: most of the screen, so a long dry-run plan reads without the Activity log's few lines. */
TextOverlay {
    align: center middle;
}

#text-overlay {
    width: 90%;
    height: 90%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#text-overlay-title {
    margin-bottom: 1;
    text-style: bold;
    color: $accent;
}

#text-overlay-scroll {
    height: 1fr;
}

#text-overlay-dismiss {
    margin-top: 1;
    color: $text-muted;
}

/* The delete dialog: a bordered box in the middle of the dimmed screen. */
DeleteDialog {
    align: center middle;
}

#delete-dialog {
    width: 90;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    border: round $error;
    background: $surface;
}

#delete-buttons {
    height: auto;
    margin-top: 1;
}

#delete-buttons Button {
    margin-right: 2;
}
